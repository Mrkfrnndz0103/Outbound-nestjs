NODE_ENV=development
PORT=3001
# Use Supabase's transaction pooler URI (port 6543), not db.<project-ref>.supabase.co.
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@POOLER_HOST:6543/postgres
# Remote databases default to SSL; set false only for a local PostgreSQL server.
DATABASE_SSL=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:5173
SEATALK_BASE_URL=
SEATALK_APP_ID=
SEATALK_APP_SECRET=
SEATALK_AUTHORIZE_URL=https://openapi.seatalk.io/open_login/qrlogin
SEATALK_TOKEN_URL=https://openapi.seatalk.io/auth/app_access_token
SEATALK_USER_URL=https://openapi.seatalk.io/open_login/code2employee
SEATALK_REDIRECT_URI=https://your-domain.example/auth/seatalk/callback
SEATALK_SUCCESS_REDIRECT=https://your-domain.example/
SEATALK_APPROVAL_ENABLED=false
SEATALK_CALLBACK_SIGNING_SECRET=
SEATALK_APPROVAL_CREATE_PATH=/approval_center/v2/create
SEATALK_APPROVE_CALLBACK_URL=https://your-domain.example/api/v1/integrations/seatalk/approval/approve
SEATALK_REJECT_CALLBACK_URL=https://your-domain.example/api/v1/integrations/seatalk/approval/reject
SEATALK_APPROVAL_ASSIGNMENT_SECONDS=180
SEATALK_APPROVAL_RETRY_SECONDS=300
SEATALK_PRESENCE_ACTIVE_SECONDS=60
SEATALK_RUNTIME_INTERVAL_MS=60000
SEATALK_HTTP_TIMEOUT_MS=10000
APP_URL=https://your-domain.example
GOOGLE_USER_IMPORTS_SYNC_ENABLED=false
GOOGLE_USER_IMPORTS_SPREADSHEET_ID=
GOOGLE_USER_IMPORTS_SHEET_NAME=user
GOOGLE_USER_IMPORTS_MAX_ROWS=5000
GOOGLE_USER_IMPORTS_SYNC_INTERVAL_MS=900000
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_CREDENTIALS_JSON=
