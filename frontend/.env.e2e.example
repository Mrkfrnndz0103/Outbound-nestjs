# Base URL for the browser tests. Leave unset to start the local Vite server.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173

# Required only for authenticated E2E setup. Use an isolated test account.
E2E_BACKROOM_OPS_ID=ops00000
E2E_BACKROOM_PASSWORD=mmmm0000

# Required when the local Vite server is used for authenticated tests.
VITE_API_URL=/api
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-test-project-publishable-key
