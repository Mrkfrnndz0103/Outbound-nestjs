APP_NAME="SOC 5 Outbound API"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.example.invalid
FRONTEND_URL=https://staging.example.invalid
PERFORMANCE_TELEMETRY=false
DB_CONNECTION=pgsql
DB_HOST=
