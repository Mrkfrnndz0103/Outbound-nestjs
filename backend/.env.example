APP_NAME="SOC 5 Outbound API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Emits per-request SQL timings locally; set false outside focused performance diagnosis.
PERFORMANCE_TELEMETRY=false
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
LOG_CHANNEL=stack
# Keep detailed application logs in the file; API request summaries are emitted separately.
LOG_STACK=single,sentry_logs
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
TRUSTED_PROXIES=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_CA_BUNDLE=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional CA bundle path for PHP cURL TLS verification.
# Leave empty when the host/container PHP installation has a configured CA store.
# If set in Docker, use a path that exists inside the container.
SUPABASE_CONNECT_TIMEOUT=5
SUPABASE_TIMEOUT=10
SUPABASE_TOKEN_CACHE_TTL=30
# Active profile cache; profile role, activation, and password-state writes invalidate it.
SUPABASE_PROFILE_CACHE_TTL=5

# SeaTalk website login. Register the exact HTTPS callback in SeaTalk Open Platform.
SEATALK_APP_ID=
SEATALK_APP_SECRET=
SEATALK_REDIRECT_URI=https://soc5outboundops.app/auth/seatalk/callback
SEATALK_SDK_URL=https://static.cdn.haiserve.com/seatalk/client/shared/sop/auth.js
SEATALK_TOKEN_URL=https://openapi.seatalk.io/auth/app_access_token
SEATALK_USER_URL=https://openapi.seatalk.io/open_login/code2employee
SEATALK_CONNECT_TIMEOUT=5
SEATALK_TIMEOUT=10

# SeaTalk Approval Center. Keep disabled until permissions, Data Scope,
# callback URLs, employee-code mappings, and callback signature format are
# confirmed with SeaTalk in a test app.
SEATALK_APPROVAL_ENABLED=false
SEATALK_CALLBACK_SIGNING_SECRET=
SEATALK_APPROVAL_BASE_URL=https://openapi.seatalk.io
# Create/get paths follow SeaTalk's documented Approval Center API paths.
SEATALK_APPROVAL_CREATE_PATH=/approval_center/v2/create
# Keep update/app paths empty until SeaTalk confirms their current contracts.
SEATALK_APPROVAL_UPDATE_PATH=
SEATALK_APPROVAL_DETAIL_PATH=/approval_center/v2/get
SEATALK_APPROVAL_APP_PATH=
SEATALK_APPROVE_CALLBACK_URL=
SEATALK_REJECT_CALLBACK_URL=
SEATALK_APPROVAL_ASSIGNMENT_SECONDS=180
SEATALK_PRESENCE_ACTIVE_SECONDS=60
SEATALK_HTTP_CONNECT_TIMEOUT=5
SEATALK_HTTP_TIMEOUT=10

# override requires the queue support migration before it is started.
# Default mode is local and synchronous. The database-backed async compose
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_CONNECTION=default
SESSION_STORE=default
# Set true for every HTTPS staging/production deployment.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Use direct outbound connections for this project.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
http_proxy=
https_proxy=
all_proxy=
NO_PROXY=*
no_proxy=*

# Sentry error, performance, profiling, and structured-log monitoring.
# Keep the DSN in deployment secrets/environment variables, not in Git.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=true
SENTRY_LOG_FLUSH_THRESHOLD=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_STRICT_TRACE_CONTINUATION=false
# Optional machine-local Cloudflare certificate path. Leave blank unless needed.
CLOUDFLARE_CERT_PATH=
CLOUDFLARE_TUNNEL_ID=aebf91e4-acf5-4eb4-aaae-8b56a58e8035
ADMIN_EMAILS=

# Google Sheets request mirror. Keep credentials outside the repository.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=1Po3LyyOAJ8Q-EbX_807RSxrA_grwmsdlsPPP4FFFBig
GOOGLE_SHEETS_SHEET_NAME=SOC5_Truck_Request_[fallback]
GOOGLE_SHEETS_MAX_ROWS=50000
GOOGLE_SHEETS_RETRY_ATTEMPTS=3
GOOGLE_SHEETS_RETRY_BACKOFF_MS=1000
GOOGLE_SHEETS_CREDENTIALS_PATH=
# Alternatively provide the complete service-account JSON as a secret.
GOOGLE_SHEETS_CREDENTIALS_JSON=

REDIS_CLIENT=predis
REDIS_HOST=
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_SCHEME=tls
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=queue
REDIS_SESSION_CONNECTION=session
