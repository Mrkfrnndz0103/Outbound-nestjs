{
  "name": "soc5-outbound-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:source && npm run check:api-versioning && tsc -p tsconfig.app.json --noEmit && vite build --configLoader native",
    "check:api-versioning": "node scripts/check-api-versioning.mjs",
    "check:encoding": "node scripts/check-visible-text-encoding.mjs",
    "check:source": "node scripts/check-source-artifacts.mjs",
    "check:robots": "node scripts/check-robots.mjs",
    "lint": "biome lint src scripts && oxlint src scripts",
    "lint:oxlint": "oxlint src scripts",
    "lint:a11y": "biome lint --only=a11y src",
    "format:check": "biome ci src",
    "test": "vitest run --exclude \"e2e/**\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@joint/core": "^4.3.3",
    "@sentry/react": "^10.74.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.38.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "2.15.4",
    "supabase": "^2.117.0",
    "tailwind-merge": "3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "jsqr": "1.4.0",
    "oxlint": "^1.83.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
